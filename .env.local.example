# Copy to .env.local for local development (gitignored, never commit real values).
# Baked in at build time — this is a static export, so these must be set
# before `next dev` / `next build`, not read at runtime.
#
# For Cloudflare Pages preview/production builds, these are set as
# project-level environment variables in the Cloudflare dashboard instead
# of this file (Preview and Production scopes are separate there) — see
# the "Preview Deployments" section in README.md.

# The ATS Match worker's URL. Defaults to the local wrangler dev server.
NEXT_PUBLIC_ATS_MATCH_API_URL=http://localhost:8787

# Leave unset to skip the real Turnstile widget entirely (dev-mode fallback:
# renders a placeholder and supplies a dummy token, matching the worker's
# own TURNSTILE_SECRET_KEY dev bypass). Set to a real site key — e.g.
# Cloudflare's public test key 1x00000000000000000000AA for local testing —
# to render the real widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
